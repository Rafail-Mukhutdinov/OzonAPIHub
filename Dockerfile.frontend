FROM cirrusci/flutter:stable AS builder
WORKDIR /app/ozon_sales_dashboard
COPY ozon_sales_dashboard/ /app/ozon_sales_dashboard/

RUN flutter pub get
RUN flutter build web --release

FROM nginx:alpine
COPY --from=builder /app/ozon_sales_dashboard/build/web /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]