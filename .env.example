# =============================================================================
# OzonAPIHub SaaS Environment Configuration
# =============================================================================
# ВНИМАНИЕ: Этот файл является ПРИМЕРОМ. Скопируйте его в .env и заполните!
# НЕ коммитьте реальный .env файл в git!
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Формат: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://ozon_user:SecurePass2024!@localhost:5432/ozon_saas

POSTGRES_USER=ozon_user
POSTGRES_PASSWORD=SecurePass2024!
POSTGRES_DB=ozon_saas

# Для production с SSL:
# DATABASE_URL=postgresql://user:pass@prod-host:5432/db?sslmode=require

# Для локальной разработки с SQLite (legacy):
# DATABASE_URL=sqlite:///orders.db

# -----------------------------------------------------------------------------
# Security & Encryption
# -----------------------------------------------------------------------------
# Ключ для шифрования Ozon credentials в БД (ОБЯЗАТЕЛЬНО!)
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here-CHANGE-ME

# JWT Secret Key для аутентификации пользователей
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-CHANGE-ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# Legacy Ozon API (для backward compatibility / admin)
# -----------------------------------------------------------------------------
# В SaaS-режиме каждый пользователь хранит свои credentials в БД
# Эти переменные нужны только для legacy кода или админа
OZON_CLIENT_ID=your-ozon-client-id
OZON_API_KEY=your-ozon-api-key

# -----------------------------------------------------------------------------
# Ozon API Settings
# -----------------------------------------------------------------------------
OZON_MAX_RETRIES=3
OZON_RETRY_BACKOFF_SECONDS=1.5
LOG_OZON_REQUESTS=false

# -----------------------------------------------------------------------------
# Sync & Background Tasks
# -----------------------------------------------------------------------------
SYNC_INTERVAL_SECONDS=300
RECENT_WINDOW_HOURS=48
MONTH_RECONCILE_INTERVAL_SECONDS=3600
MONTH_RECONCILE_MONTHS=3

# -----------------------------------------------------------------------------
# Enrichment Settings
# -----------------------------------------------------------------------------
ENRICH_ON_FETCH=true
ENRICH_ON_FETCH_LIMIT=200
ENRICH_RECENT_POSTINGS=true
ENRICH_RECENT_LIMIT=100
ENRICH_CONCURRENCY=4
ENRICH_ON_STATUS_CHANGE=true
ENRICH_STATUS_CHANGE_LIMIT=100

# -----------------------------------------------------------------------------
# Initial Sync
# -----------------------------------------------------------------------------
ENABLE_INITIAL_SYNC=true
INITIAL_WINDOW_DAYS=365
HISTORY_WINDOW_DAYS=30

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Опции: DEBUG, INFO, WARNING, ERROR, CRITICAL

# -----------------------------------------------------------------------------
# CORS (для Flutter Web frontend)
# -----------------------------------------------------------------------------
# Автоматически настроено для localhost в main.py
# Для production добавьте домены:
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# -----------------------------------------------------------------------------
# SaaS Settings
# -----------------------------------------------------------------------------
# Демо-режим (ограниченный функционал для незарегистрированных)
ENABLE_DEMO_MODE=true
DEMO_DATA_RETENTION_DAYS=7

# Лимиты для пользователей
MAX_ORDERS_PER_USER=100000
MAX_API_CALLS_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Redis & Rate Limiting
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_USER=10/minute

# -----------------------------------------------------------------------------
# Email (для регистрации и уведомлений)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Payment Integration (для подписок)
# -----------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ЮKassa (для России)
# YOOKASSA_SHOP_ID=your-shop-id
# YOOKASSA_SECRET_KEY=your-secret-key
