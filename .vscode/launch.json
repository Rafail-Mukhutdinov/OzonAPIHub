{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "FastAPI (uvicorn)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host", "127.0.0.1",
        "--port", "8080",
        "--reload",
        "--log-level", "info"
      ],
      "env": { "PYTHONUNBUFFERED": "1" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Test Accruals By Day",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/test_accruals_by_day.py",
      "args": [
        "2026-06-15"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}